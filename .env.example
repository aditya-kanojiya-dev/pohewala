# Copy to .env.local for local dev, and set these in your host's dashboard
# (Vercel: Settings > Environment Variables) for production.

# Postgres connection string (Neon, Supabase, Vercel Postgres, RDS, ...)
# e.g. postgres://user:password@host:5432/dbname
DATABASE_URL=

# Admin panel password for https://yourdomain.com/admin
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. If unset, ADMIN_PASSWORD is used.
AUTH_SECRET=

# Public site URL (no trailing slash). Used for canonical URLs, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
