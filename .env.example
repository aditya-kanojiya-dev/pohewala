# Copy to .env.local for local dev, and set these in your host's dashboard
# (Vercel: Settings > Environment Variables) for production.

# Postgres connection string (Neon, Supabase, Vercel Postgres, RDS, ...)
# e.g. postgres://user:password@host:5432/dbname
DATABASE_URL=

# Admin panel password for https://yourdomain.com/admin
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. If unset, ADMIN_PASSWORD is used.
AUTH_SECRET=

# Public site URL (no trailing slash). Used for canonical URLs, sitemap, robots.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# WhatsApp alert for new enquiries via Meta Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api).
# Leave unset to disable.
# Your WhatsApp Business phone number ID (Graph API, includes the ID).
WHATSAPP_PHONE_NUMBER_ID=
# Permanent access token from Meta Business Settings > WhatsApp > API Setup.
WHATSAPP_ACCESS_TOKEN=
# Admin number to alert, in international format, e.g. 919876543210
WHATSAPP_ADMIN_NUMBER=
# Optional: pre-approved template name + language for out-of-session alerts.
# Template body must take (name, phone, email, message) as parameters.
# Unset = plain text (only works inside the 24h customer session window).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
